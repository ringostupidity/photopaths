PORT=5000
HOST=127.0.0.1
UPSTASH_REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_DATABASE.upstash.io:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional: OpenRouteService walking directions instead of the public FOSSGIS server.
ORS_API_KEY=
# Public providers require an identifying User-Agent. Set a contact URL for deployment.
APP_USER_AGENT=Photopath/1.0
# Set NODE_ENV=production only behind HTTPS (secure session cookie).
