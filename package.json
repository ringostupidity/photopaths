{
  "name": "photopath",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write public src test scripts app.js server.js playwright.config.js vercel.json README.md package.json",
    "format:check": "prettier --check public src test scripts app.js server.js playwright.config.js vercel.json README.md package.json"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "leaflet": "^1.9.4",
    "sharp": "^0.35.4",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.8",
    "supertest": "^7.1.4"
  }
}
